# ── Smart Transaction Stack config ───────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# Network: "mainnet" (real Jito bundles + real SOL) or "testnet" (Jito testnet).
NETWORK=mainnet

# High-performance RPC (SolInfra credits / Helius / Triton / QuickNode).
RPC_URL=https://api.mainnet-beta.solana.com

# Yellowstone gRPC (Dragon's Mouth) endpoint + token.
# From SolInfra (bounty credits), Helius, or Triton.
YELLOWSTONE_GRPC_URL=https://your-endpoint.example.com
YELLOWSTONE_X_TOKEN=

# Jito Block Engine. Mainnet default below; testnet:
#   https://testnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Submitter wallet — path to a Solana keypair JSON (array of bytes).
# Use a low-balance throwaway funded with ~0.3 SOL for tips+fees.
WALLET_KEYPAIR_PATH=./wallet.json

# ── AI agent (Claude via @anthropic-ai/sdk) ──────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# Leave AI_BASE_URL empty to use the Anthropic default (api.anthropic.com);
# set it only to route through a gateway/proxy. AI_API_KEY falls back to
# ANTHROPIC_API_KEY if unset.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-opus-4-8

# Tip safety ceiling (lamports) — the agent will never exceed this per bundle.
MAX_TIP_LAMPORTS=200000
