# ── Smart Transaction Stack config ───────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# Network: "mainnet" (real Jito bundles + real SOL) or "testnet" (Jito testnet).
NETWORK=mainnet

# High-performance RPC (SolInfra credits / Helius / Triton / QuickNode).
RPC_URL=https://api.mainnet-beta.solana.com

# Yellowstone gRPC (Dragon's Mouth) endpoint + token.
# From SolInfra (bounty credits), Helius, or Triton.
YELLOWSTONE_GRPC_URL=https://your-endpoint.example.com
YELLOWSTONE_X_TOKEN=

# Jito Block Engine. Mainnet default below; testnet:
#   https://testnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Submitter wallet — path to a Solana keypair JSON (array of bytes).
# Use a low-balance throwaway funded with ~0.3 SOL for tips+fees.
WALLET_KEYPAIR_PATH=./wallet.json

# ── AI agent ─────────────────────────────────────────────────────────────────
# Two interchangeable providers — pick whichever key you have:
#
# (A) Anthropic / Claude (default):
#       AI_PROVIDER=anthropic   (or just leave it unset)
#       AI_BASE_URL=            (empty = api.anthropic.com)
#       AI_API_KEY=sk-ant-...   (or set ANTHROPIC_API_KEY)
#       AI_MODEL=claude-opus-4-8
#
# (B) FREE: any OpenAI-compatible endpoint (Groq / Gemini / OpenRouter / NVIDIA free tier):
#       AI_PROVIDER=openai
#       Groq      → AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#       Gemini    → AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#       OpenRouter→ AI_BASE_URL=https://openrouter.ai/api/v1
#       NVIDIA    → AI_BASE_URL=https://integrate.api.nvidia.com/v1   AI_API_KEY=nvapi-...
#                   Free key from build.nvidia.com (~40 req/min, frontier models).
#                   Use the EXACT model id from the model's page, e.g.
#                   AI_MODEL=deepseek-ai/deepseek-v3.1  (not the marketing name).
#                   Note: some NIM models reject response_format=json_object; if so
#                   the agent still recovers the JSON via its inline-parse path.
#       AI_API_KEY=<your free key>
#
# If AI_PROVIDER is unset but AI_BASE_URL is non-Anthropic, "openai" is assumed.
AI_PROVIDER=anthropic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-opus-4-8

# Tip safety ceiling (lamports) — the agent will never exceed this per bundle.
MAX_TIP_LAMPORTS=200000
