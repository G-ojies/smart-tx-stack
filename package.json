{
  "name": "smart-tx-stack",
  "version": "0.1.0",
  "description": "A smart Solana transaction stack: Yellowstone gRPC streaming, Jito bundles with dynamic tips, lifecycle tracking, and an AI agent that owns autonomous retry decisions.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "stream": "ts-node src/cli/hello-stream.ts",
    "submit": "ts-node src/cli/run-bundles.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "@triton-one/yellowstone-grpc": "^1.3.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "jito-ts": "^4.1.2",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
